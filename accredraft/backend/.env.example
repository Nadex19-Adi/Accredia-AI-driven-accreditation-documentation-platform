# ── Application ───────────────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=dev-secret-change-me-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accredraft

# ── Redis (optional; used only when running the RQ worker) ────────────────────
REDIS_URL=redis://localhost:6379/0

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=accredraft
S3_REGION=us-east-1

# ── LLM (leave blank to use the deterministic keyword fallback extractor) ─────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
